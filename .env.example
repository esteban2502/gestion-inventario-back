DB_HOST=localhost
DB_PORT=5432
DB_NAME=MercadoLibre
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200

# Opcional: primer usuario administrador (BCrypt al guardar). Dejar vacio en produccion si no se desea auto-alta.
# El backend ahora carga este archivo .env al arrancar (ver DotEnvLoader).
ADMIN_BOOTSTRAP_EMAIL=admin@mercadolibro-inventario.local
ADMIN_BOOTSTRAP_PASSWORD=CambiarEstaClave123
# Si ese correo ya esta registrado como vendedor, pon true UNA VEZ para subirlo a ADMIN y aplicar la contrasena de arriba.
ADMIN_BOOTSTRAP_PROMOTE_SELLER=false

# Correo con Gmail / Google Workspace (envia a cualquier destinatario)
#
# IMPORTANTE: MAIL_APP_PASSWORD NO es tu contrasena de Gmail/portal.
# Debe ser una "Contrasena de aplicacion" de 16 letras:
#   1. https://myaccount.google.com/security -> Verificacion en 2 pasos ON
#   2. https://myaccount.google.com/apppasswords -> crear clave tipo Correo
#   3. Pegar las 16 letras (con o sin espacios, el backend las quita)
#
# Si tu correo es @ucp.edu.co: solo funciona si la UCP usa Google Workspace.
# Inicia sesion en https://myaccount.google.com con tu @ucp.edu.co y crea la clave ahi.
# Si la UCP usa Outlook, cambia MAIL_HOST a smtp-mail.outlook.com
#
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu@gmail.com
MAIL_APP_PASSWORD=abcdefghijklmnop
MAIL_FROM=Mercado Libre Inventario <tu@gmail.com>
